<Project Sdk="Microsoft.NET.Sdk">

  <!--
    v1.5.0 自检工具：直接编译插件源码（和 VaultPack 一样的做法），
    在本地起一个可控的「假 GitHub / 假 Gitee」服务，把更新链路的每一步都真跑一遍。

    为什么不用 Python 起假服务：更新逻辑全在 C# 里，跨进程 + 管道会带来一堆无关变量
    （历史上就被「stdout 接 PIPE 把服务卡死」坑过一次）。这里用 TcpListener 原地起服务，
    连节流都是自己控制的。

    用法（三个参数，前缀双横线）：
      VaultSelfTest.exe            跑全部测试
      sleep N                      单纯睡 N 秒（模拟「正在运行的 Playnite」进程）
      launcher                     写一个 launcher-ran.txt（模拟被重新拉起的 Playnite）
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>VaultSelfTest</AssemblyName>
    <RootNamespace>VaultSelfTest</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
    <NoWarn>$(NoWarn);CS1591;CS0618;NU1701</NoWarn>
    <PlayniteDir Condition="'$(PlayniteDir)'==''">$(ProgramFiles)\Playnite</PlayniteDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MiniHttpServer.cs" />
    <Compile Include="MockWebDavServer.cs" />
    <Compile Include="Fixtures.cs" />
    <Compile Include="..\..\src\PlayniteVault\**\*.cs"
             Exclude="..\..\src\PlayniteVault\bin\**\*.cs;..\..\src\PlayniteVault\obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Playnite.SDK">
      <HintPath>$(PlayniteDir)\Playnite.SDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PlayniteDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
