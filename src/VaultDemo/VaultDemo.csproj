<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>VaultDemo</AssemblyName>
    <RootNamespace>VaultDemo</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
    <NoWarn>$(NoWarn);CS1591;CS0618;NU1701</NoWarn>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Playnite 安装目录：编译时要从这里引用 Playnite.SDK.dll / Newtonsoft.Json.dll。
         默认按「安装版」的常见位置猜，装在别处就覆盖这个属性，三种方式任选：
           1) 命令行   dotnet build -c Release -p:PlayniteDir="D:\Somewhere\Playnite"
           2) 环境变量 set PlayniteDir=D:\Somewhere\Playnite
           3) 直接改下面这行的默认值
         （Playnite 便携版就是解压出来的那个文件夹，ExtensionsData 就躺在它旁边。） -->
    <PlayniteDir Condition="'$(PlayniteDir)' == ''">$(ProgramFiles)\Playnite</PlayniteDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Playnite.SDK">
      <HintPath>$(PlayniteDir)\Playnite.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PlayniteDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <!-- 插件自更新要解压 release 里的 zip（VaultUpdater.Stage） -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <None Update="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
